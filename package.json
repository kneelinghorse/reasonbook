{
  "name": "@aquex/reasonbook",
  "version": "4.2.1",
  "description": "Reasonbook: decisions that survive the session, in a local record AI agents keep.",
  "mcpName": "ai.aquex/reasonbook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kneelinghorse/reasonbook.git"
  },
  "homepage": "https://github.com/kneelinghorse/reasonbook#readme",
  "bugs": {
    "url": "https://github.com/kneelinghorse/reasonbook/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./referee": {
      "types": "./dist/referee/index.d.ts",
      "require": "./dist/referee/index.js",
      "default": "./dist/referee/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "referee": [
        "dist/referee/index.d.ts"
      ]
    }
  },
  "bin": {
    "reasonbook": "./dist/bin.js"
  },
  "files": [
    "dist",
    "rbook-seed",
    "plugins/reasonbook",
    "plugins/reasonbook-chat",
    ".agents/plugins/marketplace.json",
    ".claude-plugin/marketplace.json",
    "adapters",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "TOOL_REFERENCE.md",
    "docs/getting-started.md",
    "docs/harnesses.md",
    "docs/migrating-from-cmos.md",
    "docs/trust.md",
    "docs/method.md",
    "docs/privacy.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,js}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,js}\" \"plugins/**/*.mjs\"",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,js}\" \"plugins/**/*.mjs\" --fix",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "metrics": "node scripts/collect-quality-metrics.js",
    "snapshots": "jest --runTestsByPath tests/tools/tool-definitions.test.ts --coverage=false",
    "snapshots:update": "jest --runTestsByPath tests/tools/tool-definitions.test.ts --coverage=false -u",
    "probe:router-params": "npx ts-node scripts/probe-router-params.ts",
    "probe:action-params": "npx ts-node scripts/generate-action-params.ts",
    "prune:registry": "npx ts-node scripts/prune-project-registry.ts",
    "prune:snapshots": "npx ts-node scripts/prune-context-snapshots.ts",
    "detect:corrupted": "npx ts-node scripts/detect-corrupted-decisions.ts",
    "backfill:embeddings": "npx ts-node scripts/backfill-embeddings.ts",
    "measure:retrieval:production": "npm run build && npx ts-node scripts/measure-retrieval-production.ts",
    "measure:retrieval:gate": "npm run build && npx ts-node scripts/measure-retrieval-production.ts --gate",
    "measure:retrieval:baseline": "npm run build && npx ts-node scripts/measure-retrieval-production.ts --write-baseline",
    "baseline:cross-store": "npx ts-node scripts/measure-cross-store-baseline.ts",
    "tune:retrieval:params": "npx ts-node scripts/tune-retrieval-params.ts",
    "cleanup:credkeys": "npx ts-node scripts/cleanup-stale-credkeys.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:retrieval-quality": "node scripts/retrieval-quality-gate.js",
    "test:class-sweeps": "node scripts/class-sweeps.js",
    "test:performance": "RUN_PERF_ASSERTS=1 jest --coverage=false tests/tools/rbook/e2e-lifecycle.test.ts",
    "test:identity-real-store": "jest --testMatch '**/*.fire.ts' --runTestsByPath tests/private/identity-registration-real-store.fire.ts --runInBand --coverage=false",
    "test:e2e-firstrun": "jest --config jest.e2e.config.js --runInBand",
    "verify:dist": "npx ts-node scripts/verify-dist.ts",
    "build": "tsc && node scripts/generate-build-manifest.js && node scripts/generate-tool-reference.js",
    "clean": "rm -rf dist coverage",
    "start": "node dist/index.js",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "reasonbook",
    "rbook",
    "claude",
    "codex",
    "decisions",
    "agent-hooks",
    "project-records",
    "sqlite",
    "project-management",
    "ai-agents"
  ],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.6.2",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.17.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-cucumber": "^4.5.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "better-sqlite3": "^12.6.0",
    "sqlite-vec": "^0.1.9",
    "ulid": "^3.0.2",
    "yaml": "^2.8.1",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "peerDependenciesMeta": {
    "@xenova/transformers": {
      "optional": true
    }
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    },
    "uuid": "^11.1.1"
  },
  "lint-staged": {
    "{!(*.config),!(rbook)/**/!(*.config)}.{js,ts,mjs}": [
      "eslint --cache --fix --max-warnings=0",
      "prettier --cache --write"
    ],
    "*.{json,md,yaml,yml}": "prettier --cache --write"
  }
}
